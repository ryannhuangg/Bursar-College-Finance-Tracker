{
  "name": "collegefinance",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "nodemon --watch main.js --watch index.html --watch style.css --exec npx electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.43.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "nodemon": "^3.1.14"
  },
  "build": {
    "appId": "com.ryannhuangg.bursar",
    "productName": "Bursar",
    "files": [
      "**/*",
      "!dist/**",
      "!build/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.finance"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": "AppImage"
    },
    "protocols": [
      {
        "name": "Bursar",
        "schemes": [
          "collegefinance"
        ]
      }
    ]
  },
  "allowScripts": {
    "electron@30.5.1": true
  },
  "description": "College budgeting app for students",
  "author": "Ryan"
}
